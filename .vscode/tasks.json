{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "slingr: run environment",
            "type": "shell",
            "command": "slingr run",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": {
                "owner": "slingr-runner",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^(Starting infrastructure services...)",
                    "endsPattern": "^(\\w+) application initialized"
                }
            }
        }
    ]
}